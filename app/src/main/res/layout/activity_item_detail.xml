<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="40dp">

    <ImageView
        android:id="@+id/detailImage"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="24dp"
        android:contentDescription="Изображение предмета"
        android:scaleType="fitCenter"
        tools:src="@drawable/ic_item_placeholder" />

    <TextView
        android:id="@+id/detailNameCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="24sp"
        android:textStyle="bold"
        tools:text="R-301" />

    <TextView
        android:id="@+id/detailDescriptionCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textSize="16sp"
        tools:text="Редкость: RARE" />

    <TextView
        android:id="@+id/tv_slots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:gravity="center"
        android:textSize="20sp"
        android:text="Доступные модули: "/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="0dp">



        <ImageView
            android:id="@+id/img_barrel"
            android:layout_width="0dp"
            android:layout_weight="0.2"
            android:layout_height="100dp"
            android:layout_marginTop="24dp"
            android:contentDescription="Изображение предмета"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_item_placeholder" />

        <ImageView
            android:id="@+id/img_mag"
            android:layout_width="0dp"
            android:layout_weight="0.2"
            android:layout_height="100dp"
            android:layout_marginTop="24dp"
            android:contentDescription="Изображение предмета"
            android:scaleType="fitCenter"
            tools:src="@drawable/mag_placeholder" />

        <ImageView
            android:id="@+id/img_sight"
            android:layout_width="0dp"
            android:layout_weight="0.2"
            android:layout_height="100dp"
            android:layout_marginTop="24dp"
            android:contentDescription="Изображение предмета"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_item_placeholder" />

        <ImageView
            android:id="@+id/img_stock"
            android:layout_width="0dp"
            android:layout_weight="0.2"
            android:layout_height="100dp"
            android:layout_marginTop="24dp"
            android:contentDescription="Изображение предмета"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_item_placeholder" />


    </LinearLayout>


</LinearLayout>
