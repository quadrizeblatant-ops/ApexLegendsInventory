<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tv_main_hand_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="В первом слоте пусто" />

    <TextView
        android:id="@+id/tv_sec_hand_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Во втором слоте пусто" />

    <Button
        android:id="@+id/btn_equip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Эквипнуть 1" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btn_equip_sec_hand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Экипнуть 2" />

        <Button
            android:id="@+id/btn_drop_from_sec_hand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Дропнуть 2" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_drop_from_hand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Дропнуть 1" />

    <TextView
        android:id="@+id/itemCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Инвентарь не осмотрен" />

    <Button
        android:id="@+id/btn_use"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Использовать" />

    <Button
        android:id="@+id/btn_next_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Осмотреть рюкзак" />

    <TextView
        android:id="@+id/tv_health_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="HP"/>

    <Button
        android:id="@+id/btn_drop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Выбросить" />

    <TextView
        android:id="@+id/tv_floor_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Пол не осмотрен" />

    <Button
        android:id="@+id/btn_floor_pick"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Подобрать с пола" />

    <Button
        android:id="@+id/btn_floor_inspect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Осмотреть пол" />

    <TextView
        android:id="@+id/tv_info_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="логи" />

</LinearLayout>