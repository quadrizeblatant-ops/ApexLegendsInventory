<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tv_main_hand_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="В первом слоте пусто" />

    <TextView
        android:id="@+id/tv_sec_hand_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Во втором слоте пусто" />

    <Button
        android:id="@+id/btn_equip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Эквипнуть 1" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btn_equip_sec_hand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Экипнуть 2" />

        <Button
            android:id="@+id/btn_drop_from_sec_hand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Дропнуть 2" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_drop_from_hand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Дропнуть 1" />

    <TextView
        android:id="@+id/itemCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Инвентарь пуст" />

    <Button
        android:id="@+id/switchWeaponButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Сменить оружие" />

    <TextView
        android:id="@+id/tv_hp_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="тут будет инфа по изм. хп"/>/>

    <Button
        android:id="@+id/btn_use"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Использовать" />

    <TextView
        android:id="@+id/tv_health_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="HP"/>

    <Button
        android:id="@+id/btn_next_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Осмотреть рюкзак" />

    <Button
        android:id="@+id/btn_pickup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Подобрать" />

    <Button
        android:id="@+id/btn_drop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Выбросить" />

    <TextView
        android:id="@+id/tv_full_inventory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Инвентарь не открыт" />

    <Button
        android:id="@+id/btn_open_inventory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Весь инвентарь" />

    <TextView
        android:id="@+id/tv_value_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Тут будет ценность" />

    <Button
        android:id="@+id/btn_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ценность инвентаря" />

</LinearLayout>