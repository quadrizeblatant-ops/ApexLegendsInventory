<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/itemCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Инвентарь пуст" />

    <Button
        android:id="@+id/switchWeaponButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Сменить оружие" />

    <TextView
        android:id="@+id/tv_hp_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="тут будет инфа по изм. хп"/>/>

    <Button
        android:id="@+id/btn_use"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Использовать" />

    <TextView
        android:id="@+id/tv_health_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="HP"/>

    <TextView
        android:id="@+id/tv_summaryCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:text="Ценность инвентаря" />

    <Button
        android:id="@+id/btn_value_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ценность инвентаря" />

    <Button
        android:id="@+id/btn_next_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Осмотреть рюкзак" />

    <Button
        android:id="@+id/btn_pickup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Подобрать" />

    <Button
        android:id="@+id/btn_drop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Выбросить" />

</LinearLayout>